# 将本文件复制到 compose.yaml 同级目录下，并重命名为 .env

# 【必填】镜像版本号。请前往 Releases 页面查看最新发布版本（例如 0.15.0，注意不要带 v 前缀）
MDCZ_VERSION=

# 数据持久化目录（存放数据库、任务数据与配置），默认保存在当前目录下的 ./data
MDCZ_STATE_PATH=./data

# 【必填】宿主机上的影片媒体库绝对路径（请确保该目录在宿主机上已存在）
MDCZ_MEDIA_PATH=/volume1/media

# 网页访问绑定 IP。默认 127.0.0.1 仅宿主机本机可访问；
# 若部署在 NAS 或远程服务器，需在局域网其他设备访问，请改为 0.0.0.0 或 NAS 的局域网 IP
MDCZ_BIND_IP=127.0.0.1

# 容器运行用户的 UID 与 GID（建议设置为媒体目录所有者的数字 ID，Linux 下可通过 id 命令查看）
PUID=1000
PGID=1000
UMASK=022

# 【可选】直接通过环境变量指定管理员密码（设置后将跳过网页首次设置，直接使用此密码登录）
# MDCZ_ADMIN_PASSWORD=
