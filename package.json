{
  "name": "mdcz",
  "version": "0.12.0",
  "description": "MDCz - media metadata scraper built on Electron",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/ShotHeadman/mdcz",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShotHeadman/mdcz.git"
  },
  "author": {
    "name": "ShotHeadman",
    "email": "123543875+ShotHeadman@users.noreply.github.com"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev:webui": "concurrently -n server,web -c cyan,magenta \"pnpm --filter @mdcz/server dev\" \"pnpm --filter @mdcz/web dev\"",
    "dev:desktop": "pnpm --filter @mdcz/desktop dev",
    "build:desktop": "pnpm --filter @mdcz/desktop build",
    "build:server": "pnpm --filter @mdcz/server build",
    "build:web": "pnpm --filter @mdcz/web build",
    "build:webui": "pnpm --filter @mdcz/server build:webui",
    "package:webui": "pnpm build:webui && node scripts/package-server-webui.mjs",
    "build:win": "pnpm --filter @mdcz/desktop build:win",
    "build:mac": "pnpm --filter @mdcz/desktop build:mac",
    "build:linux": "pnpm --filter @mdcz/desktop build:linux",
    "check": "pnpm typecheck && pnpm test && pnpm exec biome check .",
    "test": "vitest run --project unit --project integration --project desktop-integration --project contract --project component --silent",
    "test:apps": "pnpm --filter @mdcz/server --filter @mdcz/web test",
    "test:unit": "vitest run --project unit --silent",
    "test:integration": "vitest run --project integration --project desktop-integration --project contract --silent",
    "test:coverage": "vitest run --coverage --project unit --project integration --project desktop-integration --project contract --silent",
    "test:coverage:desktop": "vitest run --config vitest.desktop-coverage.config.ts --coverage --silent",
    "test:e2e": "node tests/e2e/web/run.mjs",
    "test:live": "node tests/live/run-live.mjs",
    "typecheck": "tsc -b --pretty false",
    "typecheck:apps": "pnpm --filter @mdcz/server --filter @mdcz/web typecheck",
    "format": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.3.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser-playwright": "4.1.5",
    "@vitest/coverage-v8": "4.1.5",
    "ajv": "^8.20.0",
    "concurrently": "^9.2.1",
    "electron": "^39.5.2",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "entities": "^7.0.1",
    "lint-staged": "^16.3.1",
    "lucide-react": "^0.563.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "^7.71.1",
    "simple-git-hooks": "^2.13.1",
    "typescript": "~5.9.0",
    "typescript-language-server": "^5.3.0",
    "vite": "^7.0.0",
    "vitest": "4.1.5",
    "vitest-browser-react": "^2.2.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "pnpm exec biome check --write --no-errors-on-unmatched"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "electron-winstaller",
      "esbuild",
      "impit",
      "sharp",
      "simple-git-hooks"
    ]
  }
}
