{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/typescript/tsconfig.desktop-renderer.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": [
    "apps/desktop/src/renderer/src/**/*.ts",
    "apps/desktop/src/renderer/src/**/*.tsx",
    "apps/desktop/src/renderer/src/**/*.d.ts",
    "packages/runtime/src/types/vendor.d.ts"
  ],
  "exclude": ["packages/**/*.test.ts"],
  "references": [{ "path": "./packages/shared" }, { "path": "./packages/ui" }, { "path": "./packages/views" }]
}
