{
  "name": "@mdcz/desktop",
  "version": "0.20.0",
  "description": "MDCz - media metadata scraper built on Electron",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "homepage": "https://github.com/ShotHeadman/mdcz",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShotHeadman/mdcz.git"
  },
  "author": {
    "name": "ShotHeadman",
    "email": "123543875+ShotHeadman@users.noreply.github.com"
  },
  "scripts": {
    "postinstall": "node postinstall.cjs",
    "dev": "electron-vite dev --config electron.vite.config.ts",
    "build": "electron-vite build --config electron.vite.config.ts && pnpm --filter @mdcz/web build --outDir ../desktop/out/web --emptyOutDir",
    "build:win": "pnpm build && electron-builder --config electron-builder.yml --win --publish never",
    "build:mac": "pnpm build && electron-builder --config electron-builder.yml --mac --publish never",
    "build:linux": "pnpm build && electron-builder --config electron-builder.yml --linux AppImage --publish never"
  },
  "dependencies": {
    "@mdcz/media-store": "workspace:*",
    "@mdcz/persistence": "workspace:*",
    "@mdcz/runtime": "workspace:*",
    "@mdcz/shared": "workspace:*",
    "@trpc/server": "^11.16.0",
    "better-sqlite3": "^12.9.0",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.9",
    "electron-window-state": "^5.0.3",
    "fast-xml-parser": "^5.3.0",
    "fastify": "^5.8.5",
    "impit": "^0.13.0",
    "mediainfo.js": "^0.3.7",
    "p-queue": "^9.0.0",
    "sharp": "^0.34.5",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "@img/sharp-darwin-arm64": "0.34.5",
    "@img/sharp-libvips-darwin-arm64": "1.2.4",
    "@img/sharp-libvips-linux-x64": "1.2.4",
    "@img/sharp-linux-x64": "0.34.5",
    "@img/sharp-win32-x64": "0.34.5",
    "impit-darwin-arm64": "0.13.0",
    "impit-linux-arm64-gnu": "0.13.0",
    "impit-linux-arm64-musl": "0.13.0",
    "impit-linux-x64-gnu": "0.13.0",
    "impit-linux-x64-musl": "0.13.0",
    "impit-win32-arm64-msvc": "0.13.0",
    "impit-win32-x64-msvc": "0.13.0"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.9.1",
    "electron-vite": "^5.0.0",
    "lint-staged": "^16.3.1"
  }
}
