{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/typescript/tsconfig.node.tsbuildinfo",
    "lib": ["ES2023"],
    "types": ["node", "electron-vite/node"]
  },
  "include": [
    "apps/desktop/electron.vite.config.ts",
    "apps/server/src/**/*.ts",
    "apps/desktop/src/main/**/*.ts",
    "apps/desktop/src/preload/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["packages/**/*.test.ts"],
  "references": [
    { "path": "./packages/shared" },
    { "path": "./packages/media-store" },
    { "path": "./packages/persistence" },
    { "path": "./packages/runtime" }
  ]
}
